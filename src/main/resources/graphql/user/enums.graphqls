# ==========================================
# User Enums (사용자 관련 Enum)
# ==========================================

"""
사용자 역할 (MVP 단순화: 3단계)
"""
enum UserRole {
  "운영자 - 모든 관리 기능"
  ADMIN
  
  "일반 회원 - 글/댓글 작성"
  MEMBER
  
  "비회원 - 읽기 전용"
  GUEST
}

"""
계정 상태
"""
enum UserStatus {
  "정상 활성 계정"
  ACTIVE
  
  "임시 정지 (레이트 리밋 위반 등)"
  SUSPENDED
  
  "영구 차단"
  BANNED
  
  "탈퇴"
  DELETED
}

"""
소셜 로그인 제공자 (MVP: Google만)
"""
enum SocialProvider {
  GOOGLE
}
