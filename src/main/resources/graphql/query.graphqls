# ==========================================
# Root Query Type
# ==========================================

"""
루트 쿼리
"""
type Query {
  # ----------------------------------------
  # Auth & User
  # ----------------------------------------

  """
  현재 인증된 사용자 정보 조회
  인증 필수
  """
  me: MePayload! @auth(requires: MEMBER)

  """
  사용자 정보 조회 (ID로)
  """
  user(id: ID!): User

}
